# This workspace contains several independent research projects. HA-WAM
# publishes the curated Cosmos-Policy, OpenPI, and FastWAM implementations.
/*
!/.gitignore
!/README.md
!/assets/
!/cosmos-policy-final/
!/openpi/
!/FastWAM/

# Local environments and machine-specific benchmark configuration.
**/.DS_Store
**/.idea/
**/.vscode/
**/.libero/
**/.liberopro/
**/.env
**/.env.*
**/*.local

# Python/build caches.
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.conda/
**/.conda-*/
**/.hf-cache/
**/.home/
**/.coverage
**/build/
**/dist/
**/*.egg-info/

# Evaluation logs, profiles, temporary files, and generated outputs.
**/logs/
**/logs*/
**/*logs/
**/explorelogs/
**/cache/
**/.cache/
**/tmp/
**/temp/
**/outputs/
**/results/
**/wandb/
**/备份/
**/runstate*/
**/*.log
**/*.flops.json
**/*.trace.json
**/*.prof
**/*.mp4
**/*.avi

# Checkpoints, model weights, and local datasets.
**/ckpt/
**/ckpts/
**/checkpoint/
**/checkpoints/
**/weights/
**/pretrained/
**/*.pt
**/*.pth
**/*.ckpt
**/*.safetensors
**/*.onnx
**/*.tflite
**/*.npy
**/*.npz
**/*.h5
**/*.hdf5

# Machine-local simulator assets in this workspace are absolute symlinks.
# Install/download the benchmark assets using the instructions in README.md.
/cosmos-policy-final/robocasa_scripts/vendor/robocasa/models/assets/
/cosmos-policy-final/LIBERO-PRO/libero/libero/assets
/cosmos-policy-final/ckpt

# Upstream repositories are committed as source snapshots. Their local Git
# metadata, environments, downloaded dependencies, simulator assets, and
# checkpoints stay machine-local.
/openpi/.git/
/openpi/third_party/
/FastWAM/.git/
/FastWAM/assets/
/FastWAM/fastwam_final/latency_calibration/
/FastWAM/third_party/
